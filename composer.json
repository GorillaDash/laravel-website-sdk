{
    "name": "gorilladash/laravel-website-sdk",
    "description": "Laravel SDK for the GorillaDash website GraphQL API with stale-while-revalidate caching for instant SSR.",
    "license": "MIT",
    "type": "library",
    "keywords": ["laravel", "gorilladash", "graphql", "ssr", "cache", "stale-while-revalidate", "sdk"],
    "authors": [
        {
            "name": "Anthony Gherghetta",
            "email": "anthony@gorilladash.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "gmostafa/php-graphql-client": "^1.14",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "GorillaDash\\WebsiteSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GorillaDash\\WebsiteSdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "GorillaDash\\WebsiteSdk\\WebsiteSdkServiceProvider"
            ],
            "aliases": {
                "GorillaDash": "GorillaDash\\WebsiteSdk\\Facades\\GorillaDash"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
